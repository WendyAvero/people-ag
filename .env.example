# Copiá este archivo a .env.local (desarrollo) o cargá estas variables en tu
# hosting (producción). NUNCA subas .env.local al repositorio.

# --- Sitio ---------------------------------------------------------------
# URL pública final, con https. Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# Redes (opcionales). Si quedan vacías, el ícono no aparece en el pie.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Analítica sin cookies con Plausible (opcional). Dejar vacío para no cargar nada.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Formulario de contacto (Etapa 2, solo servidor, secretos) ---
# Si estas tres quedan vacías, la web se publica SIN formulario (modo informativo).
# Cargarlas recién cuando la política de privacidad esté completa y revisada.
# En producción el formulario además requiere privacyIsDraft=false en site.ts.
# Cuenta en https://resend.com, dominio verificado y clave de API.
RESEND_API_KEY=
# Casilla que recibe las consultas (wendyavero@people-ag.com).
CONTACT_TO_EMAIL=
# Remitente de un dominio verificado en Resend. Ej: People AG <contacto@tu-dominio.com>
CONTACT_FROM_EMAIL=
